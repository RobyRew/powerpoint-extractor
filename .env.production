# Committed on purpose. Vite bakes VITE_* into the shipped bundle, so these are
# public identifiers, not secrets. The previous runtime-injection approach relied
# on env vars that were never set on the container, so the page carried no
# analytics tag at all.
#
# data-domains pins reporting to this hostname, so a fork deployed elsewhere
# reports nothing.
VITE_UMAMI_SCRIPT_URL=https://stats.cosmincalin.es/script.js
VITE_UMAMI_WEBSITE_ID=0990c809-402d-4231-ae3f-acc01076d37a
VITE_UMAMI_DOMAINS=ppt.robyrew.com
